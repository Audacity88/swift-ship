# Copy to .env.local and supply values from your own development services.
# Empty fields are placeholders. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Without Radar, maps, address lookup and new route estimates show an unavailable state.
# Sign-in, support, knowledge base and existing shipment lists still work.
NEXT_PUBLIC_RADAR_PUBLISHABLE_KEY=

# Optional. AI chat returns "AI not configured" without this key.
# OpenAI powers AI chat and document embeddings. Server-side only.
OPENAI_API_KEY=

# Optional override for auth cookie naming with a non-hosted Supabase URL.
NEXT_PUBLIC_SUPABASE_PROJECT_ID=

# Optional Edge Function tracing. Also set these in the function environment.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Edge Functions use SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and OPENAI_API_KEY.
# Set SUPABASE_URL to the URL reachable from that runtime, not necessarily localhost.
# LANGSMITH_ENDPOINT is only used by the dataset creation helper, not the app.
